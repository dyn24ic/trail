# Next.js OpenTopo key (used server-side in /api/elevation)
OPENTOPO_API_KEY=
OPENTOPO_DEM_TYPE=SRTMGL3

# Mapbox GL JS public token (used client-side for 3D/2D terrain map)
# Get a free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Overrides for local dev (docker-compose sets these automatically)
# BACKEND_URL=http://localhost:8000
# SCALA_URL=http://localhost:8080
